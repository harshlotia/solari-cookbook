# Required for `journeyman run` (live mode). Not read by `journeyman demo`.
# Get one at console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Optional. When set, journeys with a `description` are judged by Claude
# looking at the screenshot instead of the deterministic text/url heuristic.
# Not required — and not used in the committed proof/live bundle.
ANTHROPIC_API_KEY=
